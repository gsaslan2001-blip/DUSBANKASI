VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gemini API
# - scripts/ai-import.ts, batch-import.ts
# - Vercel serverless `api/explain.ts` (SUNUCU TARAFI — tarayıcıya sızmaz)
GEMINI_API_KEY=AIza...

# Çoklu key failover (api/explain için).
# Sıra: GEMINI_API_KEY_1 → _2 → _3 ... her model için ayrı ayrı denenir.
# Farklı Google hesaplarından alınmış key'ler kota toplamını çoğaltır.
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=AIza...
# GEMINI_API_KEY_3=AIza...

# Model öncelik sırası (virgülle, ilk başarılı olan kullanılır)
# Varsayılan: en yeni erişilebilir modelden başlayarak kalite sıralı fallback
# GEMINI_MODELS_AI=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview

# Pinecone — `api/explain.ts` içinde RAG için kullanılır.
# myppdfs indeksi Integrated Inference (multilingual-e5-large, 1024-dim).
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=myppdfs
# Opsiyonel — reranker modeli (varsayılan: bge-reranker-v2-m3)
# RERANKER_MODEL=bge-reranker-v2-m3

# DİKKAT: VITE_GEMINI_API_KEY ARTIK KULLANILMIYOR.
# Eski anahtarı .env.local'dan SİLİN (frontend'e sızma riski vardı).
# Kullanılacak Gemini model adı (varsayılan: gemini-2.5-pro-preview-05-06)
GEMINI_MODEL=gemini-2.5-pro-preview-05-06

# batch-import.ts — PDF dizini ve ders adı (hardcode yerine)
BATCH_PDF_DIR=C:\Users\...\DUS\<ders>\<ünite pdf klasörü>
BATCH_LESSON_NAME=<Ders Adı>

# notebooklm-auto.py — QUEUES env var desteği
# Her kuyruk için ayrı env var: QUEUE_<DERS>_DIR
QUEUE_PATOLOJI_DIR=C:\Users\...\DUS\patoloji\pato ünite pdf\Parcalanmis_Recovery
