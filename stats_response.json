event: message
data: {"jsonrpc":"2.0","id":1,"result":{"tools":[{"name":"add_note","description":"Add a new note to Anki. Use model_names to see available note types and model_field_names to see required fields. Returns the note ID on success. IMPORTANT: Only create notes that were explicitly requested by the user.","inputSchema":{"properties":{"deck_name":{"title":"Deck Name","type":"string"},"model_name":{"title":"Model Name","type":"string"},"fields":{"additionalProperties":{"type":"string"},"title":"Fields","type":"object"},"tags":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Tags"},"allow_duplicate":{"default":false,"title":"Allow Duplicate","type":"boolean"}},"required":["deck_name","model_name","fields"],"title":"add_noteArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"add_noteDictOutput","type":"object"}},{"name":"add_notes","description":"Add multiple notes to Anki in a single batch. Up to 100 notes sharing the same deck and model. Uses Anki's native batch API for atomic undo support. Supports partial success - individual failures don't affect others. IMPORTANT: Only create notes that were explicitly requested by the user. Returns summary counts (created, skipped, failed) and a per-note results array with status and note_id.","inputSchema":{"$defs":{"NoteEntry":{"description":"A single note to add in a batch.","properties":{"fields":{"additionalProperties":{"type":"string"},"description":"Field values as key-value pairs (e.g., {\"Front\": \"question\", \"Back\": \"answer\"})","title":"Fields","type":"object"},"tags":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"description":"Additional tags for this note (merged with shared tags)","title":"Tags"}},"required":["fields"],"title":"NoteEntry","type":"object"}},"properties":{"deck_name":{"title":"Deck Name","type":"string"},"model_name":{"title":"Model Name","type":"string"},"notes":{"items":{"$ref":"#/$defs/NoteEntry"},"title":"Notes","type":"array"},"tags":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Tags"},"allow_duplicate":{"default":false,"title":"Allow Duplicate","type":"boolean"}},"required":["deck_name","model_name","notes"],"title":"add_notesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"add_notesDictOutput","type":"object"}},{"name":"card_management","description":"Manage card organization with 9 actions:\n\n    - reposition: Reposition NEW cards in the review queue (set learning order). Only works on NEW cards (queue=0). Non-new cards are silently skipped. Returns repositioned count.\n\n    - change_deck: Move cards to a different deck (creates deck if needed). Works with ANY card type. Returns moved count and deck_id.\n\n    - bury: Manually bury cards to hide them until the next day. Works with ANY card type. Returns buried count.\n\n    - unbury: Restore all buried cards in a specific deck. Unburies ALL buried cards in the specified deck. Returns deck_name.\n\n    - suspend: Suspend cards (hide from review indefinitely until unsuspended). Works with ANY card type. Returns suspended_count.\n\n    - unsuspend: Unsuspend cards (restore suspended cards to their previous queue). Only affects cards that are currently suspended. Returns unsuspended_count and card_ids.\n\n    - set_flag: Set or remove a colored flag on cards. Flag values: 0=none/remove, 1=red, 2=orange, 3=green, 4=blue, 5-7=custom. Returns flagged count.\n\n    - set_due_date: Set or change the due date for cards. Days: '0' = due now, '5' = due in 5 days, '5-7' = random range, '5!' = also reset interval. Returns affected_count and card_ids.\n\n    - forget_cards: Reset cards back to new state (forget scheduling). Options: restore_position (default true), reset_counts (default false). Returns affected_count and card_ids.","inputSchema":{"$defs":{"BuryParams":{"description":"Parameters for bury action.","properties":{"action":{"const":"bury","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to bury","items":{"type":"integer"},"title":"Card Ids","type":"array"}},"required":["action","card_ids"],"title":"BuryParams","type":"object"},"ChangeDeckParams":{"description":"Parameters for change_deck action.","properties":{"action":{"const":"change_deck","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to move","items":{"type":"integer"},"title":"Card Ids","type":"array"},"deck":{"description":"Target deck name (use '::' for nested, e.g., 'Spanish::Verbs')","title":"Deck","type":"string"}},"required":["action","card_ids","deck"],"title":"ChangeDeckParams","type":"object"},"ForgetCardsParams":{"description":"Parameters for forget_cards action.","properties":{"action":{"const":"forget_cards","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to reset to new state","items":{"type":"integer"},"title":"Card Ids","type":"array"},"restore_position":{"default":true,"description":"Restore original new-card position","title":"Restore Position","type":"boolean"},"reset_counts":{"default":false,"description":"Reset review and lapse counts","title":"Reset Counts","type":"boolean"}},"required":["action","card_ids"],"title":"ForgetCardsParams","type":"object"},"RepositionParams":{"description":"Parameters for reposition action.","properties":{"action":{"const":"reposition","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to reposition","items":{"type":"integer"},"title":"Card Ids","type":"array"},"starting_from":{"default":0,"description":"Starting position (0-based)","title":"Starting From","type":"integer"},"step_size":{"default":1,"description":"Increment between cards","title":"Step Size","type":"integer"},"randomize":{"default":false,"description":"Shuffle before assigning positions","title":"Randomize","type":"boolean"},"shift_existing":{"default":false,"description":"Push other cards forward","title":"Shift Existing","type":"boolean"}},"required":["action","card_ids"],"title":"RepositionParams","type":"object"},"SetDueDateParams":{"description":"Parameters for set_due_date action.","properties":{"action":{"const":"set_due_date","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to reschedule","items":{"type":"integer"},"title":"Card Ids","type":"array"},"days":{"description":"Due date string: '5' = due in 5 days, '5-7' = random range, '0' = due now, '5!' = set due AND reset interval","title":"Days","type":"string"}},"required":["action","card_ids","days"],"title":"SetDueDateParams","type":"object"},"SetFlagParams":{"description":"Parameters for set_flag action.","properties":{"action":{"const":"set_flag","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to flag","items":{"type":"integer"},"title":"Card Ids","type":"array"},"flag":{"description":"Flag value: 0=none/remove, 1=red, 2=orange, 3=green, 4=blue, 5-7=custom user flags","title":"Flag","type":"integer"}},"required":["action","card_ids","flag"],"title":"SetFlagParams","type":"object"},"SuspendParams":{"description":"Parameters for suspend action.","properties":{"action":{"const":"suspend","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to suspend","items":{"type":"integer"},"title":"Card Ids","type":"array"}},"required":["action","card_ids"],"title":"SuspendParams","type":"object"},"UnburyParams":{"description":"Parameters for unbury action.","properties":{"action":{"const":"unbury","title":"Action","type":"string"},"deck_name":{"description":"Deck name to unbury all cards from","title":"Deck Name","type":"string"}},"required":["action","deck_name"],"title":"UnburyParams","type":"object"},"UnsuspendParams":{"description":"Parameters for unsuspend action.","properties":{"action":{"const":"unsuspend","title":"Action","type":"string"},"card_ids":{"description":"Card IDs to unsuspend","items":{"type":"integer"},"title":"Card Ids","type":"array"}},"required":["action","card_ids"],"title":"UnsuspendParams","type":"object"}},"properties":{"params":{"discriminator":{"mapping":{"bury":"#/$defs/BuryParams","change_deck":"#/$defs/ChangeDeckParams","forget_cards":"#/$defs/ForgetCardsParams","reposition":"#/$defs/RepositionParams","set_due_date":"#/$defs/SetDueDateParams","set_flag":"#/$defs/SetFlagParams","suspend":"#/$defs/SuspendParams","unbury":"#/$defs/UnburyParams","unsuspend":"#/$defs/UnsuspendParams"},"propertyName":"action"},"oneOf":[{"$ref":"#/$defs/RepositionParams"},{"$ref":"#/$defs/ChangeDeckParams"},{"$ref":"#/$defs/BuryParams"},{"$ref":"#/$defs/UnburyParams"},{"$ref":"#/$defs/SuspendParams"},{"$ref":"#/$defs/UnsuspendParams"},{"$ref":"#/$defs/SetFlagParams"},{"$ref":"#/$defs/SetDueDateParams"},{"$ref":"#/$defs/ForgetCardsParams"}],"title":"Params"}},"required":["params"],"title":"card_managementArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"card_managementDictOutput","type":"object"}},{"name":"create_deck","description":"Create a new empty Anki deck. Supports parent::child structure (e.g., \"Japanese::Tokyo\" creates parent deck \"Japanese\" and child deck \"Tokyo\"). Maximum 2 levels of nesting allowed. Will not overwrite existing decks. IMPORTANT: This tool ONLY creates an empty deck. DO NOT add cards or notes after creating a deck unless the user EXPLICITLY asks to add them. Wait for user instructions before adding any content. Returns deckId and created flag (false if deck already existed).","inputSchema":{"properties":{"deck_name":{"title":"Deck Name","type":"string"}},"required":["deck_name"],"title":"create_deckArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"create_deckDictOutput","type":"object"}},{"name":"create_model","description":"Create a new note type (model) in Anki with custom fields, card templates, and styling. Useful for creating specialized models like RTL (Right-to-Left) language models for Hebrew, Arabic, etc. Each model defines the structure of notes and how cards are generated from them. Returns model_id, fields list, template_count, and any template warnings.","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"},"in_order_fields":{"items":{"type":"string"},"title":"In Order Fields","type":"array"},"card_templates":{"items":{"additionalProperties":{"type":"string"},"type":"object"},"title":"Card Templates","type":"array"},"css":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Css"},"is_cloze":{"default":false,"title":"Is Cloze","type":"boolean"}},"required":["model_name","in_order_fields","card_templates"],"title":"create_modelArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"create_modelDictOutput","type":"object"}},{"name":"delete_media_file","description":"Move a media file to Anki's trash folder. The file can be recovered via Anki's 'Check Media' dialog until the trash is emptied. Sync to propagate the deletion to other devices. Confirm with the user before deleting.","inputSchema":{"properties":{"filename":{"title":"Filename","type":"string"}},"required":["filename"],"title":"delete_media_fileArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"delete_media_fileDictOutput","type":"object"}},{"name":"delete_notes","description":"Delete notes by their IDs. This will permanently remove the notes and ALL associated cards. Requires confirmDeletion=true as a safeguard — the call will fail without it. Use dry_run=true to preview what would be deleted without actually deleting anything (confirmDeletion is ignored during dry runs). Maximum 100 notes per request. Returns deletedCount, cardsDeleted, and notFoundCount.","inputSchema":{"properties":{"notes":{"items":{"type":"integer"},"title":"Notes","type":"array"},"confirmDeletion":{"title":"Confirmdeletion","type":"boolean"},"dry_run":{"default":false,"title":"Dry Run","type":"boolean"}},"required":["notes","confirmDeletion"],"title":"delete_notesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"delete_notesDictOutput","type":"object"}},{"name":"filtered_deck","description":"Manage filtered (cram) decks with 5 actions:\n\n    - create_or_update: Create a new filtered deck or update an existing one. Filtered decks temporarily borrow cards from other decks based on search queries. Cards are NOT duplicated -- they are moved temporarily. Max 2 search terms per deck (Anki hard limit). Returns deck_id and card_count. Note: Anki may modify the deck name if it conflicts.\n\n    - rebuild: Empty and re-pull cards matching the deck's search terms. Rebuilding first returns all cards to home decks, then re-searches. Returns card_count after rebuild.\n\n    - empty: Return all cards to their original decks. Card scheduling is preserved.\n\n    - delete: Return all cards to original decks and remove the deck. Cards are NOT deleted -- they go back to their home decks with scheduling intact.\n\n    - get_info: Inspect filtered deck configuration. Returns search terms, limits, order, reschedule setting, and card count for each deck. Non-filtered decks are included with is_filtered=false. Non-existent deck IDs are silently skipped (see not_found count). Max 50 deck IDs per request.","inputSchema":{"$defs":{"CreateOrUpdateParams":{"properties":{"action":{"const":"create_or_update","title":"Action","type":"string"},"deck_id":{"default":0,"description":"0 = create new deck, non-zero = update existing filtered deck","title":"Deck Id","type":"integer"},"name":{"description":"Deck name (e.g., 'Cram Session' or 'Study::Filtered')","title":"Name","type":"string"},"search_terms":{"description":"1-2 search terms defining which cards to pull","items":{"$ref":"#/$defs/SearchTermParam"},"maxItems":2,"minItems":1,"title":"Search Terms","type":"array"},"reschedule":{"default":true,"description":"Update scheduling after review (recommended True)","title":"Reschedule","type":"boolean"},"allow_empty":{"default":true,"description":"Allow creation even if search matches 0 cards. When False, the ENTIRE operation is rolled back if no cards match -- deck is NOT created.","title":"Allow Empty","type":"boolean"}},"required":["action","name","search_terms"],"title":"CreateOrUpdateParams","type":"object"},"DeleteParams":{"properties":{"action":{"const":"delete","title":"Action","type":"string"},"deck_id":{"description":"Filtered deck ID","title":"Deck Id","type":"integer"}},"required":["action","deck_id"],"title":"DeleteParams","type":"object"},"EmptyParams":{"properties":{"action":{"const":"empty","title":"Action","type":"string"},"deck_id":{"description":"Filtered deck ID","title":"Deck Id","type":"integer"}},"required":["action","deck_id"],"title":"EmptyParams","type":"object"},"GetInfoParams":{"properties":{"action":{"const":"get_info","title":"Action","type":"string"},"deck_ids":{"description":"Deck IDs to inspect (max 50)","items":{"type":"integer"},"maxItems":50,"minItems":1,"title":"Deck Ids","type":"array"}},"required":["action","deck_ids"],"title":"GetInfoParams","type":"object"},"RebuildParams":{"properties":{"action":{"const":"rebuild","title":"Action","type":"string"},"deck_id":{"description":"Filtered deck ID","title":"Deck Id","type":"integer"}},"required":["action","deck_id"],"title":"RebuildParams","type":"object"},"SearchTermParam":{"properties":{"search":{"description":"Anki search query (e.g., 'deck:Spanish is:due')","title":"Search","type":"string"},"limit":{"default":100,"description":"Max cards to pull","minimum":1,"title":"Limit","type":"integer"},"order":{"default":"random","description":"Card selection order (default matches Anki GUI)","enum":["oldest_reviewed_first","random","intervals_ascending","intervals_descending","lapses","added","due","reverse_added","retrievability_ascending","retrievability_descending","relative_overdueness"],"title":"Order","type":"string"}},"required":["search"],"title":"SearchTermParam","type":"object"}},"properties":{"params":{"discriminator":{"mapping":{"create_or_update":"#/$defs/CreateOrUpdateParams","delete":"#/$defs/DeleteParams","empty":"#/$defs/EmptyParams","get_info":"#/$defs/GetInfoParams","rebuild":"#/$defs/RebuildParams"},"propertyName":"action"},"oneOf":[{"$ref":"#/$defs/CreateOrUpdateParams"},{"$ref":"#/$defs/RebuildParams"},{"$ref":"#/$defs/EmptyParams"},{"$ref":"#/$defs/DeleteParams"},{"$ref":"#/$defs/GetInfoParams"}],"title":"Params"}},"required":["params"],"title":"filtered_deckArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"filtered_deckDictOutput","type":"object"}},{"name":"find_notes","description":"Search for notes using Anki query syntax. Returns an array of note IDs matching the query. Supports pagination with limit/offset parameters. Maximum limit is 500 per request. Examples: \"deck:Spanish\", \"tag:verb\", \"is:due\", \"front:hello\", \"added:1\" (cards added today), \"prop:due<=2\" (cards due within 2 days), \"flag:1\" (red flag), \"is:suspended\"","inputSchema":{"properties":{"query":{"title":"Query","type":"string"},"limit":{"default":100,"title":"Limit","type":"integer"},"offset":{"default":0,"title":"Offset","type":"integer"}},"required":["query"],"title":"find_notesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"find_notesDictOutput","type":"object"}},{"name":"get_card_memory_state","description":"Get FSRS memory state (stability, difficulty, retrievability) for one or more cards. Requires FSRS to be enabled. Returns per-card memory state along with scheduling info. Use recompute=True to recalculate from the review log (slower but ensures accuracy).","inputSchema":{"properties":{"card_ids":{"items":{"type":"integer"},"title":"Card Ids","type":"array"},"recompute":{"default":false,"title":"Recompute","type":"boolean"}},"required":["card_ids"],"title":"get_card_memory_stateArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"get_card_memory_stateDictOutput","type":"object"}},{"name":"get_due_cards","description":"Retrieve the next single card due for review from a specified deck in true scheduler order. IMPORTANT: Use sync tool FIRST before getting cards to ensure latest data. After getting the card, use present_card to show it to the user. Returns one card per call to ensure correct scheduler interleaving. The deck_name parameter is required - you must specify which deck to study. For voice-mode review, use skip_images=True and/or skip_audio=True to filter out cards with media. Cards with media are temporarily buried (removed from queue) and can be unburied later using the card_management tool. Response includes has_images and has_audio flags for each card.","inputSchema":{"properties":{"deck_name":{"title":"Deck Name","type":"string"},"skip_images":{"default":false,"title":"Skip Images","type":"boolean"},"skip_audio":{"default":false,"title":"Skip Audio","type":"boolean"}},"required":["deck_name"],"title":"get_due_cardsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"get_due_cardsDictOutput","type":"object"}},{"name":"get_fsrs_params","description":"Get FSRS scheduler parameters for Anki deck presets. Returns FSRS weights, desired retention, max interval, and other settings. If deck_name is empty, returns parameters for all presets with their associated decks. If deck_name is provided, returns parameters for the preset used by that deck.","inputSchema":{"properties":{"deck_name":{"default":"","title":"Deck Name","type":"string"}},"title":"get_fsrs_paramsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"get_fsrs_paramsDictOutput","type":"object"}},{"name":"get_media_files_names","description":"List all media files in Anki's media folder with optional pattern filtering. Use patterns like '*.mp3' for audio files, '*.jpg' for images, etc.","inputSchema":{"properties":{"pattern":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pattern"}},"title":"get_media_files_namesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"get_media_files_namesDictOutput","type":"object"}},{"name":"list_decks","description":"List all available Anki decks, optionally with statistics. Remember to sync first at the start of a review session for latest data. Returns deck objects with deck_id, name, and is_filtered. With include_stats=true, adds per-deck card counts (new, learn, review, total).","inputSchema":{"properties":{"include_stats":{"default":false,"title":"Include Stats","type":"boolean"}},"title":"list_decksArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"list_decksDictOutput","type":"object"}},{"name":"model_field_names","description":"Get the field names and descriptions for a specific note type (model). Use this to know what fields are required when creating notes of this type. Returns both field_names (list of strings) and fields (list of objects with name and description).","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"}},"required":["model_name"],"title":"model_field_namesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"model_field_namesDictOutput","type":"object"}},{"name":"model_names","description":"Get a list of all available note type (model) names in Anki. Use this to see what note types are available before creating notes. Returns modelNames list and commonTypes shortcuts (basic, basicReversed, cloze).","inputSchema":{"properties":{},"title":"model_namesArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"model_namesDictOutput","type":"object"}},{"name":"model_styling","description":"Get the CSS styling for a specific note type (model). This CSS is used when rendering cards of this type.","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"}},"required":["model_name"],"title":"model_stylingArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"model_stylingDictOutput","type":"object"}},{"name":"notes_info","description":"Get detailed information about specific notes including all fields, tags, model info, and CSS styling. Use this after find_notes to get complete note data. Includes CSS for proper rendering awareness. Use include_fields to return only specific fields, or exclude_fields to omit fields - useful for reducing response size in bulk queries. If both are provided, include_fields takes priority.","inputSchema":{"properties":{"notes":{"items":{"type":"integer"},"title":"Notes","type":"array"},"include_fields":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Include Fields"},"exclude_fields":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Exclude Fields"}},"required":["notes"],"title":"notes_infoArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"notes_infoDictOutput","type":"object"}},{"name":"optimize_fsrs_params","description":"Run FSRS parameter optimization for a deck config preset using Anki's built-in optimizer. This analyzes review history to find optimal FSRS weights. Set apply_results=False (default) for a dry run that shows what the optimized params would be. Set apply_results=True to save the optimized parameters. This operation runs synchronously and typically takes 5-30 seconds depending on review history size. Returns current_params vs optimized_params comparison, already_optimal flag, and applied flag.","inputSchema":{"properties":{"preset_name":{"title":"Preset Name","type":"string"},"apply_results":{"default":false,"title":"Apply Results","type":"boolean"}},"required":["preset_name"],"title":"optimize_fsrs_paramsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"optimize_fsrs_paramsDictOutput","type":"object"}},{"name":"present_card","description":"Retrieve a card's content for review. WORKFLOW: 1) Show question, 2) Wait for user answer, 3) Show answer with show_answer=true, 4) Evaluate and suggest rating (1-4), 5) Wait for user confirmation (\"ok\"/\"next\" = accept, or they provide different rating), 6) Only then use rate_card. Returns a card object with question/answer (rendered HTML), deck_name, note_type, and scheduling fields (interval, ease_factor, due, reviews, lapses).","inputSchema":{"properties":{"card_id":{"title":"Card Id","type":"integer"},"show_answer":{"default":false,"title":"Show Answer","type":"boolean"}},"required":["card_id"],"title":"present_cardArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"present_cardDictOutput","type":"object"}},{"name":"rate_card","description":"Submit a rating for a card to update Anki's spaced repetition scheduling. Use this ONLY after the user confirms or modifies your suggested rating. Do not rate automatically without user input. Returns next_review date, new_interval (days for review cards), and card_type.","inputSchema":{"properties":{"card_id":{"title":"Card Id","type":"integer"},"rating":{"title":"Rating","type":"integer"}},"required":["card_id","rating"],"title":"rate_cardArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"rate_cardDictOutput","type":"object"}},{"name":"set_fsrs_params","description":"Update FSRS parameters on a deck config preset. Can set FSRS weights, desired retention (0.70-0.99), and/or max interval. At least one parameter must be changed. Returns old/new diff for each changed field. Use get_fsrs_params first to see current values.","inputSchema":{"properties":{"preset_name":{"title":"Preset Name","type":"string"},"fsrs_params":{"anyOf":[{"items":{"type":"number"},"type":"array"},{"type":"null"}],"default":null,"title":"Fsrs Params"},"desired_retention":{"default":-1.0,"title":"Desired Retention","type":"number"},"max_interval":{"default":-1,"title":"Max Interval","type":"integer"}},"required":["preset_name"],"title":"set_fsrs_paramsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"set_fsrs_paramsDictOutput","type":"object"}},{"name":"store_media_file","description":"Store a media file to Anki's collection.media folder. Accepts files via base64 data, local file path, or URL. Use this to add images, audio, or other media files that can be referenced in note fields. Returns the stored filename and full path.","inputSchema":{"properties":{"filename":{"title":"Filename","type":"string"},"data":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Data"},"path":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Path"},"url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Url"}},"required":["filename"],"title":"store_media_fileArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"store_media_fileDictOutput","type":"object"}},{"name":"sync","description":"Synchronize local Anki collection with AnkiWeb. IMPORTANT: Always sync at the START of a review session (before getting cards) and at the END when user indicates they are done. This ensures data consistency across devices.","inputSchema":{"properties":{},"title":"syncArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"syncDictOutput","type":"object"}},{"name":"tag_management","description":"Manage tags on notes with 6 actions:\n\n    - add_tags: Add tags to notes by note IDs. Tags: space-separated tag names (e.g., 'vocab grammar'). Returns added_count.\n\n    - remove_tags: Remove tags from notes by note IDs. Tags: space-separated tag names to remove. Returns removed_count.\n\n    - replace_tags: Replace a tag with another on specific notes. Adds new_tag then removes old_tag on the given notes. Returns added_count and removed_count.\n\n    - get_tags: List all tags in the collection. No parameters needed. Returns tags array and count.\n\n    - clear_unused_tags: Remove tags that are not used by any notes. No parameters needed. Returns cleared_count.\n\n    - batch_tags: Apply multiple add/remove tag operations in a single call. Each operation specifies type ('add' or 'remove'), note_ids, and tags. Operations execute in order with partial success support. Max 50 operations. Returns per-operation results with affected_count, plus succeeded/failed totals.","inputSchema":{"$defs":{"AddTagsParams":{"description":"Parameters for add_tags action.","properties":{"action":{"const":"add_tags","title":"Action","type":"string"},"note_ids":{"description":"Note IDs to add tags to","items":{"type":"integer"},"title":"Note Ids","type":"array"},"tags":{"description":"Space-separated tag names to add (e.g., 'vocab grammar')","title":"Tags","type":"string"}},"required":["action","note_ids","tags"],"title":"AddTagsParams","type":"object"},"BatchTagsParams":{"description":"Parameters for batch_tags action.","properties":{"action":{"const":"batch_tags","title":"Action","type":"string"},"operations":{"description":"List of tag operations. Each has: type ('add'/'remove'), note_ids (list of ints), tags (space-separated string). Executed in order.","items":{"$ref":"#/$defs/TagOperation"},"title":"Operations","type":"array"}},"required":["action","operations"],"title":"BatchTagsParams","type":"object"},"ClearUnusedTagsParams":{"description":"Parameters for clear_unused_tags action.","properties":{"action":{"const":"clear_unused_tags","title":"Action","type":"string"}},"required":["action"],"title":"ClearUnusedTagsParams","type":"object"},"GetTagsParams":{"description":"Parameters for get_tags action.","properties":{"action":{"const":"get_tags","title":"Action","type":"string"}},"required":["action"],"title":"GetTagsParams","type":"object"},"RemoveTagsParams":{"description":"Parameters for remove_tags action.","properties":{"action":{"const":"remove_tags","title":"Action","type":"string"},"note_ids":{"description":"Note IDs to remove tags from","items":{"type":"integer"},"title":"Note Ids","type":"array"},"tags":{"description":"Space-separated tag names to remove (e.g., 'vocab grammar')","title":"Tags","type":"string"}},"required":["action","note_ids","tags"],"title":"RemoveTagsParams","type":"object"},"ReplaceTagsParams":{"description":"Parameters for replace_tags action.","properties":{"action":{"const":"replace_tags","title":"Action","type":"string"},"note_ids":{"description":"Note IDs to replace tags on","items":{"type":"integer"},"title":"Note Ids","type":"array"},"old_tag":{"description":"Tag to remove","title":"Old Tag","type":"string"},"new_tag":{"description":"Tag to add in place of old_tag","title":"New Tag","type":"string"}},"required":["action","note_ids","old_tag","new_tag"],"title":"ReplaceTagsParams","type":"object"},"TagOperation":{"description":"A single tag operation within a batch.","properties":{"type":{"description":"Operation type: 'add' to add tags, 'remove' to remove tags","enum":["add","remove"],"title":"Type","type":"string"},"note_ids":{"description":"Note IDs to apply this operation to","items":{"type":"integer"},"title":"Note Ids","type":"array"},"tags":{"description":"Space-separated tag names (e.g., 'vocab grammar')","title":"Tags","type":"string"}},"required":["type","note_ids","tags"],"title":"TagOperation","type":"object"}},"properties":{"params":{"discriminator":{"mapping":{"add_tags":"#/$defs/AddTagsParams","batch_tags":"#/$defs/BatchTagsParams","clear_unused_tags":"#/$defs/ClearUnusedTagsParams","get_tags":"#/$defs/GetTagsParams","remove_tags":"#/$defs/RemoveTagsParams","replace_tags":"#/$defs/ReplaceTagsParams"},"propertyName":"action"},"oneOf":[{"$ref":"#/$defs/AddTagsParams"},{"$ref":"#/$defs/RemoveTagsParams"},{"$ref":"#/$defs/ReplaceTagsParams"},{"$ref":"#/$defs/GetTagsParams"},{"$ref":"#/$defs/ClearUnusedTagsParams"},{"$ref":"#/$defs/BatchTagsParams"}],"title":"Params"}},"required":["params"],"title":"tag_managementArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"tag_managementDictOutput","type":"object"}},{"name":"update_model_styling","description":"Update the CSS styling for an existing note type (model). This changes how cards of this type are rendered in Anki. Useful for adding RTL (Right-to-Left) support, changing fonts, colors, or layout. Changes apply to all cards using this model.","inputSchema":{"properties":{"model_name":{"title":"Model Name","type":"string"},"css":{"title":"Css","type":"string"}},"required":["model_name","css"],"title":"update_model_stylingArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"update_model_stylingDictOutput","type":"object"}},{"name":"update_note_fields","description":"Update the fields of an existing note. Supports HTML content in fields and preserves CSS styling. Note: media file attachment (audio/picture) is not yet supported. WARNING: Do not view the note in Anki browser while updating, or the fields will not update properly. Close the browser or switch to a different note before updating. IMPORTANT: Only update notes that the user explicitly asked to modify.","inputSchema":{"properties":{"id":{"title":"Id","type":"integer"},"fields":{"additionalProperties":{"type":"string"},"title":"Fields","type":"object"}},"required":["id","fields"],"title":"update_note_fieldsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"update_note_fieldsDictOutput","type":"object"}},{"name":"gui_add_cards","description":"Open Anki Add Cards dialog. IMPORTANT: Only use when user explicitly requests opening the Add Cards dialog. This tool simply opens the dialog for manual note creation - it does not pre-fill any fields. For programmatic note creation, use add_note instead.","inputSchema":{"properties":{},"title":"gui_add_cardsArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_add_cardsDictOutput","type":"object"}},{"name":"gui_browse","description":"Open Anki Card Browser and search for cards using Anki query syntax. Returns array of card IDs found. IMPORTANT: Only use when user explicitly requests opening the browser. This tool is for note editing/creation workflows, NOT for review sessions. Use this to find and select cards/notes that need editing.","inputSchema":{"properties":{"query":{"title":"Query","type":"string"}},"required":["query"],"title":"gui_browseArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_browseDictOutput","type":"object"}},{"name":"gui_current_card","description":"Get information about the current card displayed in review mode. Returns card details (question, answer, deck, model, card ID, buttons, next reviews, fields) or null if not currently in review. CRITICAL: This tool is ONLY for note editing/creation workflows when user needs to check what card is currently displayed in the GUI. NEVER use this for conducting review sessions. Use the dedicated review tools (get_due_cards, present_card, rate_card) instead. IMPORTANT: Only use when user explicitly requests current card information.","inputSchema":{"properties":{},"title":"gui_current_cardArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_current_cardDictOutput","type":"object"}},{"name":"gui_deck_browser","description":"Open Anki Deck Browser dialog showing all decks. IMPORTANT: Only use when user explicitly requests opening the deck browser. This tool is for deck management and organization workflows, NOT for review sessions. Use this when user wants to see all decks or manage deck structure.","inputSchema":{"properties":{},"title":"gui_deck_browserArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_deck_browserDictOutput","type":"object"}},{"name":"gui_edit_note","description":"Open Anki note editor dialog for a specific note ID. Allows manual editing of note fields, tags, and cards in the GUI. The note editor is opened in the Anki Browser, which provides full editing capabilities. IMPORTANT: Only use when user explicitly requests editing a note via GUI. This tool is for note editing workflows when user wants to manually edit in the Anki interface. For programmatic editing, use update_note_fields instead.","inputSchema":{"properties":{"note_id":{"title":"Note Id","type":"integer"}},"required":["note_id"],"title":"gui_edit_noteArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_edit_noteDictOutput","type":"object"}},{"name":"gui_select_card","description":"Select a specific card in an open Card Browser window. Returns true if browser is open and card was selected, false if browser is not open. IMPORTANT: Only use when user explicitly requests selecting a card in the browser. This tool is for note editing/creation workflows, NOT for review sessions. The Card Browser must already be open (use guiBrowse first).","inputSchema":{"properties":{"card_id":{"title":"Card Id","type":"integer"}},"required":["card_id"],"title":"gui_select_cardArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_select_cardDictOutput","type":"object"}},{"name":"gui_show_answer","description":"Show the answer side of the current card in review mode. Returns true if in review mode, false otherwise. CRITICAL: This tool is ONLY for note editing/creation workflows when user needs to view the answer side to verify content. NEVER use this for conducting review sessions. Use the dedicated review tools (present_card) instead. IMPORTANT: Only use when user explicitly requests showing the answer.","inputSchema":{"properties":{},"title":"gui_show_answerArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_show_answerDictOutput","type":"object"}},{"name":"gui_show_question","description":"Show the question side of the current card in review mode. Returns true if in review mode, false otherwise. CRITICAL: This tool is ONLY for note editing/creation workflows when user needs to view the question side to verify content. NEVER use this for conducting review sessions. Use the dedicated review tools (present_card) instead. IMPORTANT: Only use when user explicitly requests showing the question.","inputSchema":{"properties":{},"title":"gui_show_questionArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_show_questionDictOutput","type":"object"}},{"name":"gui_undo","description":"Undo the last action or card in Anki. Returns true if undo succeeded, false otherwise. IMPORTANT: Only use when user explicitly requests undoing an action. This tool is for note editing/creation workflows, NOT for review sessions. Use this to undo mistakes in note creation, editing, or card management.","inputSchema":{"properties":{},"title":"gui_undoArguments","type":"object"},"outputSchema":{"additionalProperties":true,"title":"gui_undoDictOutput","type":"object"}}]}}

